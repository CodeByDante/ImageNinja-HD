{
  "manifest_version": 3,
  "name": "Descargador de Imágenes",
  "version": "1.0",
  "description": "Descarga todas las imágenes de la página web donde te encuentres.",
  "icons": {
    "128": "assets/icons/icon.svg"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Descargar Imágenes",
    "default_icon": "assets/icons/icon.svg"
  }
}
